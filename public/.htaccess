# SPA fallback untuk Hostinger / Apache shared hosting.
# Pastikan file ini ada di public_html bersama index.html setelah build.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Lewati request ke file/folder yang memang ada
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Selain itu, kembalikan ke index.html (client-side routing)
  RewriteRule ^ index.html [L]
</IfModule>

# Cache aset hash-based agresif
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf|png|jpg|jpeg|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Kompresi
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
